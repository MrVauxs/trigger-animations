{
	"name": "trigger-animations",
	"browserslist": [
		"last 2 Chrome versions",
		"last 2 Firefox versions",
		"last 2 Edge versions"
	],
	"type": "module",
	"private": true,
	"license": "MIT",
	"exports": {
		"./types": {
			"types": "./src/types.d.ts"
		}
	},
	"typesVersions": {
		"*": {
			"types": [
				"./src/types.d.ts"
			]
		}
	},
	"scripts": {
		"build": "vite build && bun run triggers:bundle",
		"dev": "vite",
		"lint:fix": "eslint --fix --cache",
		"triggers:bundle": "node scripts/bundleTriggers.mjs",
		"triggers:unpack": "node scripts/unpackTriggers.mjs",
		"packs:extract": "node scripts/extractPacks.mjs",
		"symlink": "node scripts/symlink.mjs"
	},
	"devDependencies": {
		"@7h3laughingman/foundry-types": "14",
		"@antfu/eslint-config": "^9.5.1",
		"@clack/prompts": "^1.8.0",
		"@foundryvtt/foundryvtt-cli": "^3.0.4",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"devalue": "^5.9.2",
		"dotenv": "^17.4.2",
		"eslint": "^10.10.0",
		"eslint-plugin-format": "^2.0.1",
		"foundryvtt-sync": "^3.0.2",
		"gsap": "^3.15.0",
		"kolorist": "^1.8.0",
		"postcss-preset-env": "^10.6.1",
		"sequencer": "https://github.com/fantasycalendar/FoundryVTT-Sequencer#4.2.3",
		"svelte": "^5.57.0",
		"terser": "^5.51.2",
		"trigger-engine": "https://github.com/reonZ/trigger-engine#3493de0",
		"typescript": "^6.0.3",
		"vite": "^7.3.6"
	}
}
